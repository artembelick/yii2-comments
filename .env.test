# Тестовый стенд (compose-проект comments-test). Лежит в git: секретов здесь нет, стенд живёт только на время прогона.
APP_ENV_FILE=.env.test

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=comments_test
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments

REDIS_HOST=redis
REDIS_PORT=6379

YII_ENV=test
YII_DEBUG=1

FRONTEND_COOKIE_KEY=test-frontend-cookie-key
BACKEND_COOKIE_KEY=test-backend-cookie-key

# Порт 80: наружу стенд не публикуется, тесты ходят на nginx по alias'ам изнутри сети.
PUBLIC_URL=http://comments.localhost
ADMIN_URL=http://admin.comments.localhost

WS_LISTEN=websocket://0.0.0.0:8000
WS_ALLOWED_ORIGINS=http://admin.comments.localhost

DISPLAY_TIMEZONE=Europe/Moscow

NGINX_PORT=80

SMOKE_ADMIN_LOGIN=smoke-admin
SMOKE_ADMIN_PASSWORD=smoke-admin-password

XDEBUG_MODE=off
