{
  "name": "comments-tools",
  "private": true,
  "description": "JS-инструменты проекта: Vitest, oxlint, oxfmt, tsc и свои проверки. Запускаются в контейнере node.",
  "type": "module",
  "scripts": {
    "test": "TZ=UTC vitest run --coverage",
    "lint:ox": "oxlint --type-aware --deny-warnings",
    "lint:fmt": "oxfmt --check \"**/*.{js,ts,json}\"",
    "lint:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint:checks": "node tools/checks/bin.js",
    "fix": "oxfmt \"**/*.{js,ts,json}\" && oxlint --type-aware --fix"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "allure": "3.33.0",
    "allure-vitest": "3.14.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.23 <23"
  }
}
