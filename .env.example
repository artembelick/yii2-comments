# Dev-стенд. Скопируйте в .env (make up делает это сам, если .env нет).

# Какой env-файл передаётся в контейнеры. В .env.test здесь стоит .env.test.
APP_ENV_FILE=.env

# Подключение к Postgres. Эти же переменные читает образ postgres при первом запуске.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments

# Подключение к Redis. Данные разделены префиксами ключей: session:, rate-limit:, ws-token:.
REDIS_HOST=redis
REDIS_PORT=6379

# Окружение Yii: dev, test или prod. YII_DEBUG — 1 или 0.
YII_ENV=dev
YII_DEBUG=1

# cookieValidationKey публичной части и админки. Любые длинные случайные строки, разные для двух частей.
FRONTEND_COOKIE_KEY=dev-frontend-cookie-key-change-me
BACKEND_COOKIE_KEY=dev-backend-cookie-key-change-me

# Полные адреса обеих частей, как их видит браузер. Клиент админки подключается к WS по /ws на ADMIN_URL.
PUBLIC_URL=http://comments.localhost:8080
ADMIN_URL=http://admin.comments.localhost:8080

# Адрес, который слушает Workerman внутри контейнера ws. nginx проксирует на него /ws.
WS_LISTEN=websocket://0.0.0.0:8000

# Разрешённые Origin для WS через запятую (OriginPolicy). Схема, хост и порт должны совпадать точно.
WS_ALLOWED_ORIGINS=http://admin.comments.localhost:8080

# Часовой пояс, в котором показываются даты. В БД и в JSON время всегда в UTC.
DISPLAY_TIMEZONE=Europe/Moscow

# Порт nginx. На dev-стенде он же опубликован на хосте, поэтому PUBLIC_URL и ADMIN_URL работают
# и из браузера на хосте, и изнутри сети compose.
NGINX_PORT=8080

# Админ для smoke. Его создаёт make admin на тестовом стенде (значения берутся из .env.test).
SMOKE_ADMIN_LOGIN=smoke-admin
SMOKE_ADMIN_PASSWORD=smoke-admin-password

# Xdebug: off или debug.
XDEBUG_MODE=off
